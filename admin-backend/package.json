{
  "name": "admin-backend",
  "version": "1.0.0",
  "description": "Dedicated Administration & Ingestion API for Job Aggregation Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run db:sync && PORT=5001 tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "PORT=5001 node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test \"tests/**/*.test.ts\"",
    "db:sync": "tsx scripts/sync-database-schema.ts",
    "prisma:generate": "tsx scripts/sync-database-schema.ts && prisma generate",
    "prisma:push": "tsx scripts/sync-database-schema.ts && prisma db push",
    "prisma:migrate": "tsx scripts/sync-database-schema.ts && prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^187.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
