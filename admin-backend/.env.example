# ---------------------------------------------------------------------------
# Admin Backend Server Configuration (Port 5001)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
ADMIN_FRONTEND_ORIGIN="http://localhost:3001"

# ---------------------------------------------------------------------------
# Database Configuration (Shared with user backend)
# ---------------------------------------------------------------------------
# Set DB_PROVIDER to "postgresql" or "mysql"
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication Secrets (Must match or be compatible with shared accounts)
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Gemini AI Configuration (Used for automated classification review)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# ---------------------------------------------------------------------------
# Background Ingestion Scheduler (Active on admin backend)
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true

# ---------------------------------------------------------------------------
# Telegram Channel Auto-Posting (@etjobcollector)
# ---------------------------------------------------------------------------
# Publishes qualifying jobs with confirmed base salary strictly > 20,000 ETB/month.
# Bot token created via @BotFather and added as Administrator to the target channel.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHANNEL_ID="@etjobcollector"

# Optional: Configurable JSON map of foreign currency exchange rates to ETB
# When omitted, foreign currency jobs without known exchange rates are safely skipped.
# Example: '{"USD":125,"EUR":135,"GBP":160}'
EXCHANGE_RATES_JSON=""

# Optional: Minimum monthly confirmed salary threshold in ETB (default: 20000)
TELEGRAM_MIN_SALARY_ETB=20000

# Optional: ISO date string cutoff to ignore historical jobs created before rollout
# Example: "2026-10-27T00:00:00.000Z"
TELEGRAM_AUTO_POST_START_DATE=""

