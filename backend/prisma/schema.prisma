// Prisma schema file for MySQL / MariaDB (Local Development)
// Source: backend/prisma/schema.mysql.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum SourceType {
  API
  RSS
  SCRAPER
}

enum WorkArrangement {
  ON_SITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
  UNSPECIFIED
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  YEARLY
}

enum JobStatus {
  ACTIVE
  EXPIRED
  CLOSED
  ARCHIVED
}

enum ClassificationStatus {
  PENDING
  CLASSIFIED
  FAILED
  REVIEW_REQUIRED
}

enum ClassificationReviewStatus {
  AUTO_APPROVED
  NEEDS_REVIEW
  MANUALLY_REVIEWED
  REJECTED
}

enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

enum ApplicationMethod {
  EXTERNAL
  INTERNAL
  BOTH
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

enum DocumentType {
  CV
  RESUME
  COVER_LETTER
  CERTIFICATE
  OTHER
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentExtractionStatus {
  NOT_EXTRACTED
  EXTRACTING
  EXTRACTED
  FAILED
}

enum DataProvenance {
  MANUAL
  CV_EXTRACTED
  IMPORTED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  role            Role             @default(CANDIDATE)
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  isEmailVerified Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  profile         UserProfile?
  savedJobs       SavedJob[]
  applications    JobApplication[]
  documents       UserDocument[]

  @@map("users")
}

model RefreshSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_sessions")
}

model JobSource {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  type            SourceType      @default(API)
  endpointUrl     String          @db.Text
  isActive        Boolean         @default(true)
  pollingInterval Int             @default(60) // in minutes
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  nextRunAt       DateTime?
  headers         Json?           // Encrypted or secret headers excluded from public responses
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  jobs            Job[]
  runs            CollectionRun[]

  @@map("job_sources")
}

model JobCategory {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  description     String?             @db.Text
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  jobs            Job[]
  classifications JobClassification[]

  @@map("job_categories")
}

model Job {
  id                       String                @id @default(uuid())
  sourceId                 String
  source                   JobSource             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId               String?
  fingerprint              String                // Stable source-specific identity hash
  originalUrl              String                @db.Text
  applicationUrl           String?               @db.Text
  rawPayload               Json?
  originalTitle            String
  originalDescription      String                @db.LongText
  normalizedTitle          String
  normalizedDescription    String                @db.LongText
  companyName              String?
  country                  String?
  city                     String?
  isRemote                 Boolean               @default(false)
  workArrangement          WorkArrangement       @default(ON_SITE)
  remoteEligibility        String?
  employmentType           EmploymentType?
  experienceLevel          ExperienceLevel?
  salaryMin                Decimal?              @db.Decimal(12, 2)
  salaryMax                Decimal?              @db.Decimal(12, 2)
  salaryCurrency           String?
  salaryPeriod             SalaryPeriod?
  publishedAt              DateTime?
  closingDate              DateTime?
  firstSeenAt              DateTime              @default(now())
  lastSeenAt               DateTime              @default(now())
  expiredAt                DateTime?
  status                   JobStatus             @default(ACTIVE)
  categoryId               String?
  category                 JobCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  classificationStatus     ClassificationStatus  @default(PENDING)
  classificationConfidence Decimal?              @db.Decimal(4, 3)
  applicationMethod        ApplicationMethod     @default(EXTERNAL)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  classifications          JobClassification[]
  savedBy                  SavedJob[]
  applications             JobApplication[]

  @@unique([sourceId, fingerprint])
  @@index([sourceId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([externalId])
  @@map("jobs")
}

model JobClassification {
  id                       String                     @id @default(uuid())
  jobId                    String
  job                      Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  categoryId               String?
  category                 JobCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  predictedCategoryName    String
  predictedExperienceLevel ExperienceLevel?
  confidence               Decimal                    @db.Decimal(4, 3)
  status                   ClassificationReviewStatus @default(NEEDS_REVIEW)
  explanation              String?                    @db.Text
  extractedSkills          Json?
  modelIdentifier          String
  promptVersion            String
  isCurrent                Boolean                    @default(true)
  createdAt                DateTime                   @default(now())

  @@index([jobId])
  @@index([isCurrent])
  @@map("job_classifications")
}

model CollectionRun {
  id             String     @id @default(uuid())
  sourceId       String
  source         JobSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  status         RunStatus  @default(RUNNING)
  recordsFetched Int        @default(0)
  jobsCreated    Int        @default(0)
  jobsUpdated    Int        @default(0)
  jobsSkipped    Int        @default(0)
  errorSummary   String?    @db.Text
  checkpoint     Json?
  createdAt      DateTime   @default(now())

  @@index([sourceId])
  @@index([startedAt])
  @@map("collection_runs")
}

model SiteSetting {
  id           String   @id @default("default")
  siteName     String   @default("JobSphere")
  tagline      String   @default("Job Aggregation Platform")
  description  String?  @db.Text
  logoUrl      String?  @db.Text
  faviconUrl   String?  @db.Text
  supportEmail String?
  footerText   String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("site_settings")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@map("admin_audit_logs")
}

model UserProfile {
  id                       String           @id @default(uuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName              String?
  preferredName            String?
  headline                 String?
  avatarUrl                String?
  avatarFileId             String?
  phoneNumber              String?
  professionalEmail        String?
  country                  String?
  city                     String?
  summary                  String?          @db.Text
  linkedInUrl              String?
  githubUrl                String?
  portfolioUrl             String?
  otherLinks               Json?
  preferredWorkArrangement WorkArrangement?
  preferredEmploymentType  EmploymentType?
  preferredExperienceLevel ExperienceLevel?
  minSalary                Decimal?         @db.Decimal(12, 2)
  maxSalary                Decimal?         @db.Decimal(12, 2)
  salaryCurrency           String?          @default("ETB")
  preferredJobTitles       Json?
  preferredCategories      Json?
  preferredLocations       Json?
  availability             String?
  onboardingCompleted      Boolean          @default(false)
  completionPercentage     Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  experiences              ProfileExperience[]
  educations               ProfileEducation[]
  certifications           ProfileCertification[]
  projects                 ProfileProject[]
  skills                   ProfileSkill[]
  languages                ProfileLanguage[]
  achievements             ProfileAchievement[]

  @@map("user_profiles")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobApplication {
  id        String            @id @default(uuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(SUBMITTED)
  coverNote String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

model UserDocument {
  id               String                   @id @default(uuid())
  userId           String                   @map("user_id")
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  driveFileId      String                   @map("drive_file_id")
  documentType     DocumentType             @default(CV) @map("document_type")
  originalFilename String                   @map("original_filename")
  mimeType         String                   @map("mime_type")
  fileSize         Int                      @map("file_size")
  fileChecksum     String?                  @map("file_checksum")
  storageProvider  String                   @default("GOOGLE_DRIVE") @map("storage_provider")
  processingStatus DocumentProcessingStatus @default(PENDING) @map("processing_status")
  extractionStatus DocumentExtractionStatus @default(NOT_EXTRACTED) @map("extraction_status")
  extractedText    String?                  @db.LongText @map("extracted_text")
  extractedData    Json?                    @map("extracted_data")
  errorMessage     String?                  @db.Text @map("error_message")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([userId])
  @@index([documentType])
  @@index([processingStatus])
  @@map("user_documents")
}

model ProfileExperience {
  id               String          @id @default(uuid())
  profileId        String          @map("profile_id")
  profile          UserProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  companyName      String          @map("company_name")
  jobTitle         String          @map("job_title")
  employmentType   EmploymentType? @map("employment_type")
  location         String?
  startDate        DateTime?       @map("start_date")
  endDate          DateTime?       @map("end_date")
  startYear        Int?            @map("start_year")
  startMonth       Int?            @map("start_month")
  endYear          Int?            @map("end_year")
  endMonth         Int?            @map("end_month")
  isCurrent        Boolean         @default(false) @map("is_current")
  description      String?         @db.Text
  responsibilities Json?
  achievements     Json?
  skillsUsed       Json?           @map("skills_used")
  relevantUrl      String?         @map("relevant_url")
  provenance       DataProvenance  @default(MANUAL)
  order            Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("profile_experiences")
}

model ProfileEducation {
  id                 String         @id @default(uuid())
  profileId          String         @map("profile_id")
  profile            UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution        String
  degree             String?
  fieldOfStudy       String?        @map("field_of_study")
  startDate          DateTime?      @map("start_date")
  endDate            DateTime?      @map("end_date")
  startYear          Int?           @map("start_year")
  startMonth         Int?           @map("start_month")
  endYear            Int?           @map("end_year")
  endMonth           Int?           @map("end_month")
  isCurrent          Boolean        @default(false) @map("is_current")
  grade              String?
  description        String?        @db.Text
  relevantCoursework Json?          @map("relevant_coursework")
  location           String?
  provenance         DataProvenance @default(MANUAL)
  order              Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("profile_educations")
}

model ProfileCertification {
  id                  String         @id @default(uuid())
  profileId           String         @map("profile_id")
  profile             UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String?        @map("issuing_organization")
  type                String?        @default("CERTIFICATION")
  issueDate           DateTime?      @map("issue_date")
  expiryDate          DateTime?      @map("expiry_date")
  issueYear           Int?           @map("issue_year")
  issueMonth          Int?           @map("issue_month")
  credentialId        String?        @map("credential_id")
  credentialUrl       String?        @map("credential_url")
  description         String?        @db.Text
  provenance          DataProvenance @default(MANUAL)
  order               Int            @default(0)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("profile_certifications")
}

model ProfileProject {
  id               String         @id @default(uuid())
  profileId        String         @map("profile_id")
  profile          UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name             String
  description      String?        @db.Text
  role             String?
  startDate        DateTime?      @map("start_date")
  endDate          DateTime?      @map("end_date")
  startYear        Int?           @map("start_year")
  startMonth       Int?           @map("start_month")
  endYear          Int?           @map("end_year")
  endMonth         Int?           @map("end_month")
  isCurrent        Boolean        @default(false) @map("is_current")
  technologies     Json?
  responsibilities Json?
  achievements     Json?
  liveUrl          String?        @map("live_url")
  repoUrl          String?        @map("repo_url")
  provenance       DataProvenance @default(MANUAL)
  order            Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("profile_projects")
}

model ProfileSkill {
  id              String         @id @default(uuid())
  profileId       String         @map("profile_id")
  profile         UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  proficiency     String?
  yearsExperience Int?           @map("years_experience")
  provenance      DataProvenance @default(MANUAL)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([profileId, name])
  @@index([profileId])
  @@map("profile_skills")
}

model ProfileLanguage {
  id          String         @id @default(uuid())
  profileId   String         @map("profile_id")
  profile     UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  proficiency String?
  provenance  DataProvenance @default(MANUAL)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([profileId, name])
  @@index([profileId])
  @@map("profile_languages")
}

model ProfileAchievement {
  id           String         @id @default(uuid())
  profileId    String         @map("profile_id")
  profile      UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  type         String?        @default("AWARD")
  organization String?
  date         DateTime?
  year         Int?
  month        Int?
  description  String?        @db.Text
  relevantUrl  String?        @map("relevant_url")
  provenance   DataProvenance @default(MANUAL)
  order        Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("profile_achievements")
}
