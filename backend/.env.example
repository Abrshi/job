NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database Configuration (MySQL vs PostgreSQL)
# ---------------------------------------------------------------------------
# Set DB_PROVIDER to "mysql" or "postgresql" (or let it auto-detect from DATABASE_URL protocol).
#
# Option A: Local MySQL / MariaDB
DB_PROVIDER=mysql
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Option B: Cloud / Production PostgreSQL (e.g. Supabase, Neon, Railway, RDS)
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

FRONTEND_ORIGIN="http://localhost:3000"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
GEMINI_API_KEY=""
