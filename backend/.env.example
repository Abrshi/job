NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database Configuration (MySQL vs PostgreSQL)
# ---------------------------------------------------------------------------
# Set DB_PROVIDER to "mysql" or "postgresql" (or let it auto-detect from DATABASE_URL protocol).
#
# Option A: Local MySQL / MariaDB
DB_PROVIDER=mysql
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Option B: Cloud / Production PostgreSQL (e.g. Supabase, Neon, Railway, RDS)
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

FRONTEND_ORIGIN="http://localhost:3000"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# ---------------------------------------------------------------------------
# Google Drive Storage Configuration (Service Account)
# ---------------------------------------------------------------------------
# In local development without Google Drive credentials, the application
# gracefully operates in local persistent storage mode.
#
# Note: Google Service Accounts do not have personal storage quota.
# To use Google Drive cloud storage:
# 1. Create a folder in your Google Drive (e.g. "JobPlatformUploads").
# 2. Share the folder with your CLIENT_EMAIL as "Editor".
# 3. Copy the folder ID from the URL and set GOOGLE_DRIVE_FOLDER_ID below.
#
# Supported formats (both direct JSON keys and GOOGLE_* prefixed names are supported):
CLIENT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
PROJECT_ID="your-project-id"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# Optional additional fields from Service Account JSON:
TYPE="service_account"
PRIVATE_KEY_ID="your-private-key-id"
CLIENT_ID="your-client-id"
AUTH_URI="https://accounts.google.com/o/oauth2/auth"
TOKEN_URI="https://oauth2.googleapis.com/token"
AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
CLIENT_X509_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/your-service-account"
UNIVERSE_DOMAIN="googleapis.com"
# Email and SMS Verification Configuration
GOOGLE_APP_PASSWORD="aaaa bbbb cccc dddd"
EMAIL_USER="example@gmail.com"
SMS_DEVICE_TOKEN="eXAMPLE"
SMS_API_URL="https://sms-connect.vercel.app"

SMS_API_URL="https://sms-connect.vercel.app"