# ---------------------------------------------------------------------------
# Server Environment & Port Configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database Configuration (Dual Support: PostgreSQL or MySQL / MariaDB)
# ---------------------------------------------------------------------------
# Set DB_PROVIDER to "postgresql" or "mysql" (or let it auto-detect from DATABASE_URL protocol).
#
# Option A: Local MySQL / MariaDB
# DB_PROVIDER=mysql
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/job_platform"
#
# Option B: Cloud / Production PostgreSQL (e.g. Neon, Supabase, RDS)
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication & JWT Secrets (Argon2id + Dual Token Strategy)
# ---------------------------------------------------------------------------
# Secrets must be secure random strings of at least 16 characters (32+ recommended)
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Optional: Initial admin password used during production seeding (npm run seed)
# ADMIN_INITIAL_PASSWORD="SecureProductionAdminPassword123!"

# ---------------------------------------------------------------------------
# Gemini AI Configuration (CV Extraction & AI Application Document Studio)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# ---------------------------------------------------------------------------
# Google Drive Storage Configuration (Service Account)
# ---------------------------------------------------------------------------
# When configured, uploaded resumes/avatars are persisted to Google Drive.
# If omitted or invalid in development, the system falls back gracefully to local storage.
#
# Setup Instructions:
# 1. Create a Google Cloud Service Account with Google Drive API enabled.
# 2. Create a folder in Google Drive (e.g., "JobPlatformUploads").
# 3. Share the folder with your Service Account email (CLIENT_EMAIL) as "Editor".
# 4. Copy the folder ID from the URL and set GOOGLE_DRIVE_FOLDER_ID below.
#
CLIENT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
PROJECT_ID="your-project-id"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# Maximum upload file size in Megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------------------
# Email Delivery Service (Nodemailer via SMTP / Gmail App Password)
# ---------------------------------------------------------------------------
# Used for account verification links and saved search alert emails
EMAIL_USER="your-email@gmail.com"
GOOGLE_APP_PASSWORD="aaaa bbbb cccc dddd"

# ---------------------------------------------------------------------------
# SMS Verification Service (SMS-Connect Gateway)
# ---------------------------------------------------------------------------
# Used for phone number OTP verification for job seekers
SMS_DEVICE_TOKEN="your-sms-connect-device-token"
SMS_API_URL="https://sms-connect.vercel.app"
