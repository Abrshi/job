# ==============================================================================
# Telegram Ingestion Worker Environment Variables
# ==============================================================================

# Application Environment & Operational Server Port
NODE_ENV=development
PORT=5002
LOG_LEVEL=info

# Telegram MTProto API Credentials (obtain from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"

# Persistent Telegram Session String (GramJS StringSession)
# Generate once via authorized Telegram login or CLI script
TELEGRAM_SESSION=""

# Path to fallback session file if not passing session via environment
TELEGRAM_SESSION_FILE="./sessions/gramjs.session"

# Existing Backend API Configuration
BACKEND_URL="http://localhost:5000"
INTERNAL_API_SECRET="development_telegram_worker_internal_secret_key_12345"
WEBHOOK_PATH="/api/v1/internal/telegram/messages"
CHANNELS_SYNC_PATH="/api/v1/internal/telegram/channels"

# Outbox & Webhook Delivery Engine Settings
OUTBOX_DB_PATH="./sessions/outbox.db"
OUTBOX_FLUSH_INTERVAL_MS=3000
MAX_RETRY_ATTEMPTS=10
WEBHOOK_TIMEOUT_MS=15000

# Channels are managed dynamically via the Admin Dashboard (http://localhost:3001/telegram)
# No channel environment variables required.
